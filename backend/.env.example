# Copy this file to .env and adjust. Never commit .env.

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of web origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase "Session pooler" connection string (secret!)
DATABASE_URL=

# Your Supabase project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=

# Optional: fine-grained GitHub token with public read only (server-side only)
GITHUB_TOKEN=

# AI provider: mock (works with no key) | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Where uploaded files are stored in development (git-ignored)
STORAGE_DIR=storage

# LOCAL DEV ONLY: skip Supabase. Uses token "dev-token" and a local SQLite file (dev.db).
# Refused unless ENVIRONMENT=development. Never set this anywhere else.
DEV_AUTH_BYPASS=false

# Ask Placey: web search. Used only when a user clicks Ask Placey; answers are cached in the placey_cache table.
# It also uses GEMINI_API_KEY above, with the model below (default gemini-2.5-pro).
TAVILY_API_KEY=
# PLACEY_MODEL=gemini-2.5-pro

# 1-click Vercel deploy of published portfolios. Every portfolio becomes a project in ONE Vercel account.
# VERCEL_TOKEN: Vercel dashboard -> Account Settings -> Tokens. SERVER secret with full account access:
# never commit it or expose it to the frontend. Leave VERCEL_TEAM_ID empty for a personal account.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=osp-
# Where the Next.js app runs; the deploy fetches the same static snapshot as the ZIP export from here.
FRONTEND_ORIGIN=http://localhost:3000
