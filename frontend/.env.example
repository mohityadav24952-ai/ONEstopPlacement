# Copy this file to .env.local and fill in real values. Never commit .env.local.

# URL of the FastAPI backend (used from Stage 6)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public address of THIS app once deployed (no trailing slash), e.g. https://my-app.vercel.app
# Portfolio links (copy, share, QR, SEO tags) are built from it. Leave empty in local development:
# the address the page is open on is used instead.
NEXT_PUBLIC_BASE_URL=

# Supabase public identifiers (used from Stage 8). Public keys only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# LOCAL DEV ONLY: skip Supabase and sign in as a test user. Ignored in production builds.
# The backend must also have DEV_AUTH_BYPASS=true.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
