# Copy this file to .env.local and fill in real values. Never commit .env.local.

# URL of the FastAPI backend (used from Stage 6)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase public identifiers (used from Stage 8). Public keys only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# LOCAL DEV ONLY: skip Supabase and sign in as a test user. Ignored in production builds.
# The backend must also have DEV_AUTH_BYPASS=true.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
